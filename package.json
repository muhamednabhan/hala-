{
  "name": "hala-concierge",
  "private": true,
  "type": "module",
  "description": "HALA Concierge: bilingual (Arabic + English) voice agent for Dubai Silicon Oasis. Voice of the Oasis hackathon.",
  "workspaces": ["agent/*"],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "agent:sync": "tsx --env-file=.env.local agent/05-provisioning/src/sync-cli.ts",
    "agent:dev": "npm run dev -w @hala/talk-app",
    "evals:live": "tsx --env-file=.env.local agent/07-evals/src/live-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
