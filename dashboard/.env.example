# Copy to .env.local (git-ignored).
# mock = seeded demo data (always works) · live = the team's agent server + ElevenLabs
VITE_DATA_MODE=mock

# Live mode only. If the agent runs on this laptop these are read automatically from
# ../.env.hala and ../.env.local, so you can leave them empty.
TALK_APP_URL=http://localhost:3005
HALA_ADMIN_KEY=
HALA_TOOL_SECRET=
ELEVENLABS_API_KEY=
HALA_AGENT_ID=
HALA_AGENT_ID_ROBOT=
