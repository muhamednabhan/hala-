# Copy to .env.local (git-ignored). On Vercel, set these in Project → Settings → Environment Variables.

# mock = demo data (always works) · live = the team's data. The header switch can override per browser.
VITE_DATA_MODE=mock

# Staff password for live data. Required on a deployment (it refuses live data without one); optional locally.
DASHBOARD_PASSWORD=

# Supabase (team project). SERVICE key: server-side only, never prefix with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional: ElevenLabs conversations (transcripts, summaries, evaluation) for web/phone calls.
ELEVENLABS_API_KEY=
HALA_AGENT_ID=
HALA_AGENT_ID_ROBOT=

# Optional fallback: the agent server's admin API, and cancel/move via the agent's own tools.
# Read automatically from ../.env.hala when the agent runs on this laptop.
TALK_APP_URL=http://localhost:3005
HALA_ADMIN_KEY=
HALA_TOOL_SECRET=
